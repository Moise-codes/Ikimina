# ---------------------------------------------------------------------------
# Ikimina API - example environment file.
#
# Copy it and replace every placeholder with a real value:
#     cp .env.example .env
#
# NEVER commit the real `.env`. Only this file (with fake values) is committed.
# The application refuses to start if a required value is missing or weak.
# ---------------------------------------------------------------------------

# Runtime environment: local | development | staging | production.
# Controls safe defaults (for example, whether the API docs are exposed).
ENVIRONMENT=local

# --- PostgreSQL (used by docker-compose and to build DATABASE_URL) -----------
POSTGRES_USER=ikimina
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ikimina
# Extra database created for the test suite (see docker/postgres/init).
POSTGRES_TEST_DB=ikimina_test
# Host port the container is published on. Change it if 5432 is already in use
# (then also update the ports inside DATABASE_URL below).
POSTGRES_PORT=5432

# --- Redis (used by docker-compose and to build REDIS_URL) -------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Connection URLs ---------------------------------------------------------
# The "+psycopg" suffix selects the psycopg 3 driver for SQLAlchemy.
DATABASE_URL=postgresql+psycopg://ikimina:change-me-postgres@localhost:5432/ikimina
# Optional. If omitted, the test database is derived from DATABASE_URL by
# replacing the database name with POSTGRES_TEST_DB.
# TEST_DATABASE_URL=postgresql+psycopg://ikimina:change-me-postgres@localhost:5432/ikimina_test
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- Secrets -----------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-32-plus-character-secret

# URL-safe base64 of exactly 32 random bytes, used to encrypt sensitive
# provider data (account holder names, receiving-account references).
# Generate one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-generate-a-32-byte-base64url-key

# --- Token lifetimes ---------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---------------------------------------------------------------------
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Login lockout -----------------------------------------------------------
LOCKOUT_MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_OTP_SEND_PER_HOUR=5
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5

# --- HTTP security -----------------------------------------------------------
# Comma-separated. Never use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Serve /docs, /redoc and /openapi.json. When left unset, docs are enabled only
# in local/development environments and disabled everywhere else.
# DOCS_ENABLED=true

# --- Money limits (whole RWF) ------------------------------------------------
MIN_CONTRIBUTION_RWF=100
MAX_TRANSACTION_RWF=100000000

# --- Database connection pool ------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Localisation ------------------------------------------------------------
TIMEZONE=Africa/Kigali
